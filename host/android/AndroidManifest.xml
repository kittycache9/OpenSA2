<?xml version="1.0" encoding="utf-8"?>
<!-- com.sa2recomp.app: SA2 Recompiled for Android (arm64-v8a), packaged without Gradle by
     tools/s8/android_app.py (aapt2 link sets minSdk 29, targetSdk 35 and the version).
     The game is an executable in lib/arm64-v8a/libsa2game.so, exec'd by the play screen from the
     native library folder, so the libraries are extracted at install (extractNativeLibs). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sa2recomp.app"
    android:installLocation="internalOnly">

    <uses-feature android:name="android.hardware.vulkan.level" android:version="0" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:extractNativeLibs="true"
        android:appCategory="game"
        android:isGame="true"
        android:theme="@style/SetupTheme"
        android:hardwareAccelerated="true">

        <activity android:name=".Sa2SetupActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <activity android:name=".Sa2SettingsActivity"
            android:label="@string/app_name"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode" />

        <!-- The touch controls' layout editor: full screen, in the orientation it edits. -->
        <activity android:name=".Sa2LayoutActivity"
            android:label="@string/app_name"
            android:exported="false"
            android:theme="@style/PlayTheme"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode" />

        <!-- sensorLandscape is the default orientation's: when the settings choose portrait or
             auto-rotate, Sa2Activity asks for that itself. -->
        <activity android:name=".Sa2Activity"
            android:label="@string/app_name"
            android:process=":play"
            android:launchMode="singleTask"
            android:exported="false"
            android:theme="@style/PlayTheme"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:preferMinimalPostProcessing="true"
            android:alwaysRetainTaskState="true"
            android:configChanges="layoutDirection|locale|fontScale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation" />

        <!-- The Debug Export's ZIPs for the share sheet (ExportProvider): not exported; the app
             picked in the share sheet reads the one URI the intent grants it. -->
        <provider android:name=".ExportProvider"
            android:authorities="com.sa2recomp.app.exports"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
